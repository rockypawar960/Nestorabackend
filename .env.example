# =============================================
# NESTORA BACKEND — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# =============================================

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/nestora?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=nestora_app             # Required. Dedicated MySQL application user; do not use root
DB_PASSWORD=                        # Required. MySQL password
DB_ROOT_PASSWORD=                   # Required for Docker Compose MySQL service only

# --- JWT ---
JWT_SECRET=                         # Required. Min 32 characters. Use a random hex or base64 string.
                                    # Generate: openssl rand -hex 32
JWT_ACCESS_EXPIRY_MS=900000         # Optional. Default: 15 minutes (900000 ms)
JWT_REFRESH_EXPIRY_MS=604800000     # Optional. Default: 7 days (604800000 ms)

# --- Admin Seed (applied on first startup via Phase 1 initialiser) ---
ADMIN_EMAIL=admin@example.invalid   # Required. Replace with the seeded Admin account email
ADMIN_PASSWORD=                     # Required. Plain text; will be BCrypt-hashed on startup
ADMIN_NAME=Example Admin            # Optional. Display name for the Admin account

# --- Mail (Gmail SMTP) ---
MAIL_USERNAME=                      # Required. Gmail address used to send OTPs and notifications
MAIL_PASSWORD=                      # Required. Gmail App Password (NOT your Gmail login password)
                                    # Enable 2FA on Gmail and generate an App Password.

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=              # Required for Phase 2+ image uploads
CLOUDINARY_API_KEY=                 # Required for Phase 2+
CLOUDINARY_API_SECRET=              # Required for Phase 2+

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173   # Frontend origin. Comma-separated for multiple.

# --- Upload Limits ---
MAX_FILE_SIZE=5MB                   # Max size per uploaded file
MAX_REQUEST_SIZE=30MB               # Max total multipart request size

# --- Server ---
SERVER_PORT=8080                    # Optional. Default: 8080
SPRING_PROFILES_ACTIVE=dev          # Use 'prod' in production

# --- Tuning (optional) ---
OTP_RESEND_COOLDOWN_SECONDS=60      # Seconds a user must wait before requesting a new OTP
NEARBY_PLACES_CACHE_TTL_DAYS=30     # Days before nearby-place cache is refreshed from Overpass
